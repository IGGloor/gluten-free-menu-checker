# Copy this file to .env and fill in your own values. Never commit .env.

# Required: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: a Jina Reader key raises the rate limit (https://jina.ai/reader/)
# JINA_API_KEY=
