# Copy this file to .env and fill in your own values. Never commit .env.

# Required: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: a Jina Reader key raises the rate limit (https://jina.ai/reader/)
# JINA_API_KEY=

# Optional: limits on menu checks (0 turns a limit off)
# RATE_LIMIT_PER_MINUTE=5
# DAILY_ANALYSIS_CAP=200

# Optional: PostgreSQL for saving analyses and the 24-hour cache.
# For the local database from `docker compose up -d`:
# DATABASE_URL=postgresql://forkcast:forkcast@localhost:5432/forkcast
# For Neon, use the pooled connection string here, and the direct one for migrations:
# DATABASE_URL_UNPOOLED=
# The tests use a separate database (its name must contain "test"); this is the default:
# TEST_DATABASE_URL=postgresql://forkcast:forkcast@localhost:5432/forkcast_test
